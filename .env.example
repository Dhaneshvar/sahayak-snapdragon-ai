# Copy these into your shell (PowerShell: $env:NAME="value"). No secrets are needed.
# Leave empty to auto-discover Foundry Local via `foundry service status`.
SAHAYAK_LLM_BASE_URL=
# Model alias or id (see `foundry model list`). NPU variants are preferred automatically.
SAHAYAK_LLM_MODEL=phi-3.5-mini
# Privacy guard: only set to 1 for development against a non-localhost server.
SAHAYAK_ALLOW_REMOTE=0
SAHAYAK_LLM_TIMEOUT=180
SAHAYAK_MAX_DOC_CHARS=12000
SAHAYAK_MAX_FILE_MB=20
